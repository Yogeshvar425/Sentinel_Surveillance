# Copy this file to .env and fill in your values.
# Never commit .env to git (it's in .gitignore). Then: chmod 600 .env

# ── Camera ── (quote the URL — the & needs quoting)
RTSP_URL="rtsp://<user>:<password>@<camera-ip>:554/cam/realmonitor?channel=1&subtype=1"

# ── Telegram ── bot token from @BotFather, chat id from @userinfobot
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ── Dashboard login ──
# DASH_PASS is REQUIRED — the dashboard rejects every request if it's unset (fail-closed).
DASH_USER=admin
DASH_PASS=change-me-to-a-strong-password

# NOTE: YOLO_MODEL, FACE_DB_PATH and INTRUDER_LOG are NOT read from this file —
# they are constants at the top of surveillance4_1.py. Edit them there.
